# Style of the C/C++ sources (clang-format 15+, needs InsertBraces). Run: clang-format -i $(git ls-files '*.c' '*.h' '*.cpp')
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 125
UseTab: Never
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterStruct: false
  AfterEnum: false
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AlignAfterOpenBracket: Align
AlignConsecutiveMacros: Consecutive
PointerAlignment: Right
SortIncludes: false
IndentCaseLabels: false
InsertBraces: true
