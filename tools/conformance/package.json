{
  "name": "brick-conformance-tools",
  "private": true,
  "type": "module",
  "description": "Exports golden conformance fixtures from the TypeScript reference (grayhex/ApolloBrickGames). Needed only to regenerate fixtures; the C tests never run Node.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "export:tetris": "node build.mjs tetris && node dist/export_tetris.mjs",
    "export:snake": "node build.mjs snake && node dist/export_snake.mjs",
    "export:racing": "node build.mjs racing && node dist/export_racing.mjs",
    "export:tank": "node build.mjs tank && node dist/export_tank.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
